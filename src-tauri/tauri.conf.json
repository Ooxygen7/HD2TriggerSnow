{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD2 Macro Terminal Rust",
  "version": "0.1.2",
  "identifier": "com.hd2.trigger.rust",
  "build": {
    "frontendDist": "../ui",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HD2 Macro Terminal",
        "width": 715,
        "height": 1030,
        "minWidth": 715,
        "minHeight": 1030,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https:;",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/": ""
    }
  }
}
